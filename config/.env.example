# Copy to config/.env and fill in from your app at https://developers.eveonline.com/
ESI_CLIENT_ID=
ESI_CLIENT_SECRET=
# Must match the Callback URL registered for the app
ESI_CALLBACK_URL=https://tools.meadowworks.space/auth/callback
# Space or comma separated; every scope the app may ask for
ESI_SCOPES=esi-wallet.read_character_wallet.v1 esi-wallet.read_corporation_wallet.v1 esi-assets.read_assets.v1 esi-characters.read_loyalty.v1 esi-industry.read_character_jobs.v1 esi-markets.read_character_orders.v1 esi-characters.read_blueprints.v1 esi-wallet.read_corporation_wallets.v1 esi-corporations.read_divisions.v1 esi-assets.read_corporation_assets.v1 esi-corporations.read_blueprints.v1 esi-industry.read_corporation_jobs.v1 esi-markets.read_corporation_orders.v1 esi-industry.read_character_mining.v1 esi-industry.read_corporation_mining.v1 publicData esi-universe.read_structures.v1
EVE_USE_PKCE=true
# Signs the session cookie; set any long random string
SESSION_SECRET=
SERVER_PORT=5050
# Postgres, e.g. postgres://user:password@localhost:5432/eve; run the tools/db scripts on it first
DATABASE_URL=
# Encrypts saved sign-in tokens: a base64 32 byte key, e.g. from
#   openssl rand -base64 32
# Changing it makes every saved token unreadable, so everyone signs in again
TOKEN_ENCRYPTION_KEY=
